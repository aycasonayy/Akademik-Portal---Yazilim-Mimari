<!DOCTYPE html>
<html lang="tr" data-bs-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] – AkademiPortal</title>

    <!-- Bootstrap 5.3 -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet"
          integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH"
          crossorigin="anonymous" />
    <!-- Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"
          rel="stylesheet" />

    <style>
        /* ── Genel ──────────────────────────────────────────────── */
        :root {
            --ap-birincil:   #1a4fa0;
            --ap-koyu:       #0a0f1e;
            --ap-yuzey:      #f0f3f8;
            --ap-kenar:      #d4dae6;
            --ap-vurgu:      #e8305a;
        }
        body {
            background-color: var(--ap-yuzey);
            font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
        }

        /* ── Üst çubuk ─────────────────────────────────────────── */
        .navbar-brand-logo {
            width: 38px; height: 38px;
            background: linear-gradient(135deg, #1a4fa0, #4a8fe8);
            border-radius: 9px;
            display: flex; align-items: center; justify-content: center;
        }

        /* ── İstatistik kartları ────────────────────────────────── */
        .stat-card {
            border: none;
            border-radius: 14px;
            box-shadow: 0 2px 14px rgba(0,0,0,.08);
            transition: transform .2s, box-shadow .2s;
        }
        .stat-card:hover { transform: translateY(-3px); box-shadow: 0 6px 22px rgba(0,0,0,.13); }
        .stat-icon-box {
            width: 54px; height: 54px; border-radius: 13px;
            display: flex; align-items: center; justify-content: center;
        }

        /* ── Bölüm kartları ─────────────────────────────────────── */
        .section-card {
            border: none;
            border-radius: 14px;
            box-shadow: 0 2px 14px rgba(0,0,0,.08);
        }
        .section-card .card-header {
            border-radius: 14px 14px 0 0 !important;
        }

        /* ── Terminal / Log konsolu ─────────────────────────────── */
        .log-konsol {
            background-color: #0a0f1e;
            color: #c9d1d9;
            font-family: 'Cascadia Code', 'Fira Code', 'Consolas', monospace;
            font-size: .8rem;
            line-height: 1.7;
            height: 360px;
            overflow-y: auto;
            padding: 1rem 1.3rem;
            border-radius: 0 0 14px 14px;
        }
        .log-konsol::-webkit-scrollbar       { width: 6px; }
        .log-konsol::-webkit-scrollbar-track { background: #161b2e; }
        .log-konsol::-webkit-scrollbar-thumb { background: #2e3a5c; border-radius: 3px; }
        .log-entry   { margin-bottom: 2px; white-space: pre-wrap; word-break: break-all; }
        .log-ts      { color: #5a6a8a; }
        .log-eposta  { color: #58a6ff; }
        .log-sms     { color: #3fb950; }
        .log-sistem  { color: #e3b341; }
        .log-rozet-eposta  { background:#1a3a6a; color:#58a6ff; padding:1px 6px; border-radius:4px; font-weight:700; }
        .log-rozet-sms     { background:#0a3020; color:#3fb950; padding:1px 6px; border-radius:4px; font-weight:700; }
        .log-rozet-sistem  { background:#3d2a00; color:#e3b341; padding:1px 6px; border-radius:4px; font-weight:700; }

        .log-konsol-baslik {
            background-color: #131929;
            border-radius: 14px 14px 0 0;
            padding: .65rem 1.3rem;
            display: flex; align-items: center; justify-content: space-between;
            border-bottom: 1px solid #2e3a5c;
        }
        .terminal-nokta { width:12px; height:12px; border-radius:50%; display:inline-block; }

        /* ── Yanıp sönen durum noktası ──────────────────────────── */
        @@keyframes yanipSon { 0%,100%{opacity:1} 50%{opacity:.2} }
        .yanip-son { animation: yanipSon 2s ease-in-out infinite; }

        /* ── Kullanıcı satırı ───────────────────────────────────── */
        .kullanici-satiri:hover { background-color: rgba(26,79,160,.05); }

        /* ── Duyuru akordeon ────────────────────────────────────── */
        .accordion-button:not(.collapsed) { background-color: #e4edff; color: #1a4fa0; }
        .rozet-sinav   { background-color: #dc3545; }
        .rozet-etkinlik{ background-color: #198754; }

        /* ── Boş durum ──────────────────────────────────────────── */
        .bos-durum { color: #8c95a4; padding: 2.5rem 0; text-align: center; }
        .bos-durum i { font-size: 2.8rem; opacity: .25; }

        /* ── Alt bilgi ──────────────────────────────────────────── */
        footer { background: #fff; border-top: 1px solid var(--ap-kenar); }
    </style>
</head>
<body>

<!-- ── Üst Çubuk Gezinme Menüsü ────────────────────────────────────────── -->
<nav class="navbar navbar-expand-lg navbar-dark shadow-sm"
     style="background: linear-gradient(90deg,#0a0f1e 0%,#1a2d5a 100%);">
    <div class="container-fluid px-4">

        <a class="navbar-brand d-flex align-items-center gap-2 fw-bold" href="/">
            <div class="navbar-brand-logo">
                <i class="bi bi-broadcast-pin text-white fs-5"></i>
            </div>
            <span>Akademi<span class="text-info">Portal</span></span>
        </a>

        <button class="navbar-toggler border-0" type="button"
                data-bs-toggle="collapse" data-bs-target="#navMenu">
            <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="navMenu">
            <ul class="navbar-nav me-auto mb-2 mb-lg-0 ms-3">
                <li class="nav-item">
                    <a class="nav-link active" href="/">
                        <i class="bi bi-speedometer2 me-1"></i>Gösterge Paneli
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="/Home/GetLogs" target="_blank">
                        <i class="bi bi-code-slash me-1"></i>Log API
                    </a>
                </li>
            </ul>
            <div class="d-flex align-items-center gap-3">
                <span class="badge bg-success px-3 py-2 fs-6">
                    <i class="bi bi-circle-fill me-1 yanip-son" style="font-size:.5rem;"></i>Sistem Aktif
                </span>
                <span class="text-white-50 small d-none d-lg-inline">
                    <i class="bi bi-calendar3 me-1"></i>@DateTime.Now.ToString("dd MMMM yyyy, dddd")
                </span>
            </div>
        </div>

    </div>
</nav>

<!-- ── Ana İçerik ─────────────────────────────────────────────────────── -->
<main class="container-fluid px-4 py-4" style="max-width:1600px;">
    @RenderBody()
</main>

<!-- ── Alt Bilgi ──────────────────────────────────────────────────────── -->
<footer class="py-3 mt-2">
    <div class="container-fluid px-4">
        <div class="d-flex flex-wrap justify-content-between align-items-center">
            <p class="mb-0 text-muted small">
                <i class="bi bi-broadcast-pin me-1 text-primary"></i>
                <strong>AkademiPortal</strong> — Duyuru ve Bildirim Yönetim Sistemi
            </p>
            <p class="mb-0 text-muted small">
                ASP.NET Core 8 MVC &middot; Temiz Katmanlı Mimari &middot;
                Fabrika, Gözlemci &amp; Tekil Örüntüleri
            </p>
        </div>
    </div>
</footer>

<!-- Bootstrap 5.3 JS -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
        integrity="sha384-YvpcrYf0tY3lHB60NNkmXc4s9bIOgUxi8T/jzmDMPUmWJpq+8d2OHDNITzEEpKx"
        crossorigin="anonymous"></script>

@RenderSection("Scripts", required: false)
</body>
</html>
