@model DashboardViewModel
@{
    ViewData["Title"] = "Gösterge Paneli";
    int logSira = 0;
}

<style>
    /* ── Duyuru toggle butonu ──────────────────────────────────── */
    .ann-btn {
        display:     flex;
        align-items: center;
        gap:         .75rem;
        width:       100%;
        background:  #ffffff;
        border:      none;
        padding:     .9rem 1rem;
        cursor:      pointer;
        text-align:  left;
    }
    .ann-btn:hover                          { background: #f4f7ff; }
    .ann-btn:focus                          { outline: none; box-shadow: none; }
    .ann-btn[aria-expanded="true"]          { background: #edf2ff; }

    /* Chevron rotates via CSS; Bootstrap 5 JS updates aria-expanded automatically */
    .chev-icon                              { transition: transform .25s ease; flex-shrink: 0; }
    .ann-btn[aria-expanded="true"] .chev-icon { transform: rotate(180deg); }

    /* ── Log konsolu ───────────────────────────────────────────── */
    .log-konsol {
        background-color: #0a0f1e;
        color:            #c9d1d9;
        font-family:      'Cascadia Code', 'Fira Code', 'Consolas', monospace;
        font-size:        .8rem;
        line-height:      1.7;
        height:           350px;
        overflow-y:       auto;
        padding:          1rem 1.3rem;
        border-radius:    0 0 14px 14px;
    }
    .log-konsol::-webkit-scrollbar       { width: 6px; }
    .log-konsol::-webkit-scrollbar-track { background: #161b2e; }
    .log-konsol::-webkit-scrollbar-thumb { background: #2e3a5c; border-radius: 3px; }
    .log-entry   { margin-bottom: 2px; white-space: pre-wrap; word-break: break-all; }
    .log-ts      { color: #5a6a8a; }
    .log-eposta  { color: #58a6ff; }
    .log-sms     { color: #3fb950; }
    .log-sistem  { color: #e3b341; }
    .log-rozet-eposta { background:#1a3a6a; color:#58a6ff; padding:1px 6px; border-radius:4px; font-weight:700; }
    .log-rozet-sms    { background:#0a3020; color:#3fb950; padding:1px 6px; border-radius:4px; font-weight:700; }
    .log-rozet-sistem { background:#3d2a00; color:#e3b341; padding:1px 6px; border-radius:4px; font-weight:700; }
    .log-konsol-baslik {
        background-color: #131929;
        border-radius:    14px 14px 0 0;
        padding:          .65rem 1.3rem;
        display:          flex;
        align-items:      center;
        justify-content:  space-between;
        border-bottom:    1px solid #2e3a5c;
    }
    .terminal-nokta { width:12px; height:12px; border-radius:50%; display:inline-block; }

    /* ── Genel kart stilleri ───────────────────────────────────── */
    .stat-card   { border:none; border-radius:14px; box-shadow:0 2px 14px rgba(0,0,0,.08); transition:transform .2s,box-shadow .2s; }
    .stat-card:hover { transform:translateY(-3px); box-shadow:0 6px 22px rgba(0,0,0,.13); }
    .stat-icon-box { width:54px; height:54px; border-radius:13px; display:flex; align-items:center; justify-content:center; }
    .section-card { border:none; border-radius:14px; box-shadow:0 2px 14px rgba(0,0,0,.08); }
    .section-card .card-header { border-radius:14px 14px 0 0 !important; }
    .kullanici-satiri:hover { background-color:rgba(26,79,160,.04); }

    @* Bootstrap inline animation for the status dot *@
    @@keyframes yanipSon { 0%,100%{opacity:1} 50%{opacity:.2} }
    .yanip-son { animation: yanipSon 2s ease-in-out infinite; }
</style>

<!-- ════════════════════════════════════════════════════════
     SAYFA BAŞLIĞI
     ════════════════════════════════════════════════════════ -->
<div class="d-flex flex-wrap justify-content-between align-items-start mb-4 gap-2">
    <div>
        <h1 class="h3 fw-bold mb-0" style="color:#0a0f1e;">
            <i class="bi bi-speedometer2 text-primary me-2"></i>Duyuru Yönetim Paneli
        </h1>
        <p class="text-muted mb-0 mt-1 small">
            Gerçek zamanlı bildirim yönetimi &middot;
            Fabrika &middot; Gözlemci &middot; Tekil tasarım örüntüleri devrede
        </p>
    </div>
    <div class="d-flex align-items-center gap-2">
        <a href="@Url.Action("Index","Home")" class="btn btn-sm btn-outline-secondary">
            <i class="bi bi-arrow-clockwise me-1"></i>Yenile
        </a>
        <span class="badge text-bg-success px-3 py-2">
            <i class="bi bi-circle-fill me-1 yanip-son" style="font-size:.45rem;"></i>@Model.SystemStatus
        </span>
    </div>
</div>

<!-- ════════════════════════════════════════════════════════
     FLASH MESAJ
     ════════════════════════════════════════════════════════ -->
@if (!string.IsNullOrEmpty(Model.FlashMessage))
{
    <div class="alert @(Model.FlashIsSuccess ? "alert-success" : "alert-warning") alert-dismissible fade show d-flex align-items-center gap-2 mb-4 rounded-3 shadow-sm" role="alert">
        <i class="bi @(Model.FlashIsSuccess ? "bi-check-circle-fill" : "bi-exclamation-triangle-fill") fs-5 flex-shrink-0"></i>
        <div class="flex-grow-1">@Model.FlashMessage</div>
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<!-- ════════════════════════════════════════════════════════
     SATIR 1 — METRİK KARTLAR
     Gerekli: Toplam Kullanıcı | Yayınlanan Duyurular | Sistem Durumu
     ════════════════════════════════════════════════════════ -->
<div class="row g-3 mb-4">

    <!-- Toplam Kullanıcı -->
    <div class="col-xl col-md-4 col-sm-6">
        <div class="card stat-card h-100">
            <div class="card-body d-flex align-items-center gap-3 p-3">
                <div class="stat-icon-box" style="background:#e4edff;">
                    <i class="bi bi-people-fill fs-4 text-primary"></i>
                </div>
                <div>
                    <div class="text-uppercase text-muted" style="font-size:.67rem;letter-spacing:.06em;font-weight:600;">Toplam Kullanıcı</div>
                    <div class="h2 fw-bold mb-0 lh-1">@Model.TotalUsers</div>
                    <div class="text-muted" style="font-size:.75rem;">Kayıtlı Gözlemciler</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Öğrenci -->
    <div class="col-xl col-md-4 col-sm-6">
        <div class="card stat-card h-100">
            <div class="card-body d-flex align-items-center gap-3 p-3">
                <div class="stat-icon-box" style="background:#e3f6ec;">
                    <i class="bi bi-mortarboard-fill fs-4 text-success"></i>
                </div>
                <div>
                    <div class="text-uppercase text-muted" style="font-size:.67rem;letter-spacing:.06em;font-weight:600;">Öğrenci</div>
                    <div class="h2 fw-bold mb-0 lh-1">@Model.TotalStudents</div>
                    <div class="text-muted" style="font-size:.75rem;">Aktif Öğrenciler</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Akademisyen -->
    <div class="col-xl col-md-4 col-sm-6">
        <div class="card stat-card h-100">
            <div class="card-body d-flex align-items-center gap-3 p-3">
                <div class="stat-icon-box" style="background:#fff8e1;">
                    <i class="bi bi-person-badge-fill fs-4 text-warning"></i>
                </div>
                <div>
                    <div class="text-uppercase text-muted" style="font-size:.67rem;letter-spacing:.06em;font-weight:600;">Akademisyen</div>
                    <div class="h2 fw-bold mb-0 lh-1">@Model.TotalTeachers</div>
                    <div class="text-muted" style="font-size:.75rem;">Öğretim Üyeleri</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Yayınlanan Duyurular -->
    <div class="col-xl col-md-4 col-sm-6">
        <div class="card stat-card h-100">
            <div class="card-body d-flex align-items-center gap-3 p-3">
                <div class="stat-icon-box" style="background:#f0e8ff;">
                    <i class="bi bi-megaphone-fill fs-4" style="color:#7c3aed;"></i>
                </div>
                <div>
                    <div class="text-uppercase text-muted" style="font-size:.67rem;letter-spacing:.06em;font-weight:600;">Yayınlanan Duyurular</div>
                    <div class="h2 fw-bold mb-0 lh-1">@Model.TotalAnnouncements</div>
                    <div class="text-muted" style="font-size:.75rem;">Bu Oturumda</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Sistem Durumu -->
    <div class="col-xl col-md-4 col-sm-6">
        <div class="card stat-card h-100">
            <div class="card-body d-flex align-items-center gap-3 p-3">
                <div class="stat-icon-box" style="background:#e3f6ec;">
                    <i class="bi bi-activity fs-4 text-success"></i>
                </div>
                <div>
                    <div class="text-uppercase text-muted" style="font-size:.67rem;letter-spacing:.06em;font-weight:600;">Sistem Durumu</div>
                    <div class="h4 fw-bold mb-0 lh-1 text-success">@Model.SystemStatus</div>
                    <div class="text-muted" style="font-size:.75rem;">
                        <span class="text-info">✉ @Model.EmailNotificationCount</span>&nbsp;
                        <span class="text-success">📱 @Model.SmsNotificationCount</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

</div>

<!-- ════════════════════════════════════════════════════════
     SATIR 2 — DUYURU FORMU (sol)  +  GÖZLEMCI TABLOSU (sağ)
     ════════════════════════════════════════════════════════ -->
<div class="row g-4 mb-4">

    <!-- ─── SOL: Yeni Duyuru Yayınla ────────────────────────── -->
    <div class="col-xl-5 col-lg-5">
        <div class="card section-card h-100">
            <div class="card-header py-3" style="background:linear-gradient(90deg,#1a4fa0,#3a7fe8);color:#fff;">
                <h5 class="mb-0 fw-semibold"><i class="bi bi-send-fill me-2"></i>Yeni Duyuru Yayınla</h5>
                <small class="opacity-75">Fabrika doğru alt sınıfı oluşturur &middot; Gözlemci hedef kitleyi bildirir</small>
            </div>
            <div class="card-body p-4">

                <!-- Form posts to PublishAnnouncement(title, content, type, targetAudience) -->
                <form asp-controller="Home" asp-action="PublishAnnouncement" method="post" id="duyuruFormu">
                    @Html.AntiForgeryToken()

                    <!-- name="type" → AnnouncementType type (Exam / Event) -->
                    <div class="mb-3">
                        <label for="duyuruTipi" class="form-label fw-semibold">
                            <i class="bi bi-tags-fill me-1 text-primary"></i>Duyuru Tipi
                        </label>
                        <select name="type" id="duyuruTipi" class="form-select form-select-lg" required>
                            <option value="" disabled selected>— Tip Seçiniz —</option>
                            <option value="Exam">📝 Sınav Duyurusu</option>
                            <option value="Event">🎉 Kampüs Etkinliği</option>
                        </select>
                    </div>

                    <!-- name="title" → string title -->
                    <div class="mb-3">
                        <label for="duyuruBaslik" class="form-label fw-semibold">
                            <i class="bi bi-type-h1 me-1 text-primary"></i>Başlık
                        </label>
                        <input type="text" name="title" id="duyuruBaslik"
                               class="form-control form-control-lg"
                               placeholder="ör. Matematik Final Sınavı – Bahar 2025"
                               maxlength="120" required />
                    </div>

                    <!-- name="content" → string content -->
                    <div class="mb-3">
                        <label for="duyuruIcerik" class="form-label fw-semibold">
                            <i class="bi bi-card-text me-1 text-primary"></i>İçerik
                        </label>
                        <textarea name="content" id="duyuruIcerik" class="form-control" rows="3"
                                  placeholder="Duyuru ayrıntılarını buraya yazınız…"
                                  maxlength="500" required></textarea>
                    </div>

                    <!-- name="targetAudience" → string targetAudience ("Herkes" / "Student" / "Teacher") -->
                    <div class="mb-4">
                        <label for="hedefKitle" class="form-label fw-semibold">
                            <i class="bi bi-funnel-fill me-1 text-primary"></i>Hedef Kitle
                        </label>
                        <select name="targetAudience" id="hedefKitle" class="form-select">
                            <option value="Herkes">👥 Herkes (@Model.TotalUsers kullanıcı)</option>
                            <option value="Student">🎓 Sadece Öğrenciler (@Model.TotalStudents öğrenci)</option>
                            <option value="Teacher">👨‍🏫 Sadece Akademisyenler (@Model.TotalTeachers akademisyen)</option>
                        </select>
                        <div class="form-text">
                            Seçilen kitleye ait kullanıcılar <code>Register()</code> ile gözlemci olarak kayıt edilir.
                        </div>
                    </div>

                    <div class="alert alert-info py-2 mb-4 small">
                        <i class="bi bi-info-circle-fill me-1"></i>
                        <strong>Fabrika</strong> alt sınıf oluşturur →
                        <strong>Gözlemci</strong> hedef kitleyi bildirir →
                        <strong>Tekil</strong> log girdileri kaydeder.
                    </div>

                    <button type="submit" id="gonderBtn" class="btn btn-primary btn-lg w-100 fw-semibold">
                        <i class="bi bi-megaphone-fill me-2"></i>Duyuru Yayınla ve Bildir
                    </button>
                </form>

            </div>
            <div class="card-footer bg-light px-4 py-2">
                <div class="d-flex flex-wrap gap-3 small text-muted">
                    <span><i class="bi bi-diagram-3-fill text-primary me-1"></i>Fabrika Örüntüsü</span>
                    <span><i class="bi bi-broadcast text-success me-1"></i>Gözlemci Örüntüsü</span>
                    <span><i class="bi bi-lock-fill text-warning me-1"></i>Tekil Örüntüsü</span>
                </div>
            </div>
        </div>
    </div>

    <!-- ─── SAĞ: Kayıtlı Gözlemci Kullanıcılar ──────────────── -->
    <div class="col-xl-7 col-lg-7">
        <div class="card section-card h-100 d-flex flex-column">
            <div class="card-header py-3" style="background:linear-gradient(90deg,#145a3a,#1e8a55);color:#fff;">
                <h5 class="mb-0 fw-semibold">
                    <i class="bi bi-broadcast me-2"></i>Kayıtlı Gözlemci Kullanıcılar
                    <span class="badge bg-white text-success ms-2">@Model.TotalUsers</span>
                </h5>
                <small class="opacity-75">
                    <code class="text-white-50">Register()</code> ile dinamik kayıt &middot;
                    <code class="text-white-50">IObserver.Update()</code> ile bildirim
                </small>
            </div>

            <div class="table-responsive flex-grow-1">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4" style="width:40px;">#</th>
                            <th>Ad Soyad</th>
                            <th>E-posta</th>
                            <th>Telefon</th>
                            <th class="text-center">Rol</th>
                            <th class="text-center">Bildirim</th>
                            <th class="text-center pe-3">Aksiyon</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Users.Any())
                        {
                            <tr>
                                <td colspan="7" class="text-center py-5 text-muted">
                                    <i class="bi bi-person-x fs-2 d-block mb-2 opacity-25"></i>
                                    Gözlemci listesi boş. Yeni gözlemci eklemek için aşağıdaki butonu kullanın.
                                </td>
                            </tr>
                        }
                        @foreach (var k in Model.Users)
                        {
                            <tr class="kullanici-satiri">
                                <td class="ps-4 text-muted small">@k.Id</td>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="rounded-circle d-flex align-items-center justify-content-center flex-shrink-0"
                                             style="width:34px;height:34px;background:@(k.UserType == UserType.Student ? "#e4edff" : "#fff8e1");">
                                            <i class="bi @k.UserTypeIcon @(k.UserType == UserType.Student ? "text-primary" : "text-warning")"></i>
                                        </div>
                                        <span class="fw-semibold">@k.FullName</span>
                                    </div>
                                </td>
                                <td class="text-muted" style="font-size:.8rem;">@k.Email</td>
                                <td class="text-muted" style="font-size:.8rem;">@k.Phone</td>
                                <td class="text-center">
                                    <span class="badge @k.UserTypeBadgeClass rounded-pill px-3">@k.UserTypeTurkish</span>
                                </td>
                                <td class="text-center">
                                    @if (k.ReceivedNotifications.Count > 0)
                                    {
                                        <span class="badge bg-success rounded-pill">
                                            <i class="bi bi-check2 me-1"></i>@k.ReceivedNotifications.Count
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary rounded-pill opacity-50">0</span>
                                    }
                                </td>
                                <td class="text-center pe-3">
                                    <form asp-controller="Home" asp-action="RemoveObserver" method="post" class="d-inline mb-0">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="userId" value="@k.Id" />
                                        <button type="submit"
                                                class="btn btn-sm btn-outline-danger py-0 px-2"
                                                title="Gözlemci listesinden kaldır"
                                                onclick="return confirm('Bu kullanıcıyı gözlemci listesinden kaldırmak istediğinize emin misiniz?');">
                                            <i class="bi bi-trash3"></i>
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Card footer: "Yeni Gözlemci Ekle" açar Bootstrap 5 Modal -->
            <div class="card-footer bg-light px-4 py-3 d-flex justify-content-between align-items-center flex-wrap gap-2">
                <span class="small text-muted">
                    <i class="bi bi-info-circle me-1"></i>
                    Kullanıcılar dinamik olarak eklenip kaldırılabilir.
                </span>
                <button type="button"
                        class="btn btn-outline-primary btn-sm fw-semibold"
                        data-bs-toggle="modal"
                        data-bs-target="#addObserverModal">
                    <i class="bi bi-person-plus-fill me-1"></i>Yeni Gözlemci Ekle
                </button>
            </div>
        </div>
    </div>

</div>

<!-- ════════════════════════════════════════════════════════
     SATIR 3 — YAYINLANAN DUYURULAR  (DÜZELTİLMİŞ COLLAPSE)

     Bootstrap 5 Collapse bağlama kuralları:
       TOGGLE: data-bs-toggle="collapse"
               data-bs-target="#announcement-{id}"
               (herhangi bir tıklanabilir element üzerinde)
       HEDEF:  id="announcement-{id}"
               class="collapse"
               (açılacak/kapanacak alan)
     Bootstrap 5 JS; aria-expanded'ı otomatik günceller.
     CSS .ann-btn[aria-expanded="true"] .chev-icon chevron'u döndürür.
     ════════════════════════════════════════════════════════ -->
<div class="row g-4 mb-4">
    <div class="col-12">
        <div class="card section-card">
            <div class="card-header py-3" style="background:linear-gradient(90deg,#5a0f8a,#9050d8);color:#fff;">
                <h5 class="mb-0 fw-semibold">
                    <i class="bi bi-collection-fill me-2"></i>Yayınlanan Duyurular
                    <span class="badge bg-white ms-2" style="color:#7c3aed;">@Model.TotalAnnouncements</span>
                </h5>
                <small class="opacity-75">
                    Her girdi <code class="text-white-50">AnnouncementFactory</code> tarafından oluşturulmuş
                    ve Gözlemci örüntüsüyle hedef kitleye yayınlanmıştır
                </small>
            </div>
            <div class="card-body p-3">
                @{ int dSira = 0; }
                @if (Model.TotalAnnouncements == 0)
                {
                    <div class="text-center py-5 text-muted">
                        <i class="bi bi-inbox fs-1 d-block mb-2 opacity-25"></i>
                        <p class="fw-semibold mb-1">Henüz duyuru yayınlanmadı</p>
                        <p class="small mb-0">Yeni bir duyuru oluşturmak için soldaki formu kullanın.</p>
                    </div>
                }
                else
                {
                    @foreach (var duyuru in Model.AnnouncementsDescending)
                    {
                        dSira++;
                        bool isSinav = duyuru is ExamAnnouncement;

                        <div class="card mb-2 rounded-3 overflow-hidden"
                             style="border:1px solid @(isSinav ? "#f5c2c7" : "#a3cfbb");">

                            <!-- TOGGLE BUTTON
                                 data-bs-toggle="collapse" →  Bootstrap 5 JS picks this up
                                 data-bs-target="#announcement-@duyuru.Id" → must match collapse div id
                                 aria-expanded is updated automatically by Bootstrap JS -->
                            <button type="button"
                                    class="ann-btn rounded-top-3"
                                    data-bs-toggle="collapse"
                                    data-bs-target="#announcement-@duyuru.Id"
                                    aria-expanded="@(dSira == 1 ? "true" : "false")"
                                    aria-controls="announcement-@duyuru.Id">

                                @if (isSinav)
                                {
                                    <i class="bi bi-journal-bookmark-fill text-danger fs-5 flex-shrink-0"></i>
                                }
                                else
                                {
                                    <i class="bi bi-calendar-event-fill text-success fs-5 flex-shrink-0"></i>
                                }

                                <span class="fw-semibold flex-grow-1 text-dark text-truncate">@duyuru.Title</span>

                                <span class="badge @(isSinav ? "bg-danger" : "bg-success") rounded-pill px-3 flex-shrink-0">
                                    @(isSinav ? "Sınav" : "Etkinlik")
                                </span>

                                <small class="text-muted flex-shrink-0 d-none d-sm-block">
                                    <i class="bi bi-clock me-1"></i>@duyuru.PublishedAt.ToString("HH:mm:ss  dd MMM")
                                </small>

                                <!-- Chevron rotates via CSS when aria-expanded="true" -->
                                <i class="bi bi-chevron-down text-secondary chev-icon"></i>

                            </button>

                            <!-- COLLAPSE TARGET
                                 id="announcement-@duyuru.Id" → MUST match data-bs-target above
                                 class="collapse" → Bootstrap 5 JS adds/removes "show" class
                                 First item starts open with "show" added -->
                            <div id="announcement-@duyuru.Id"
                                 class="collapse @(dSira == 1 ? "show" : "")">
                                <div class="p-3 border-top">
                                    <div class="row g-3">
                                        <div class="col-md-7">
                                            <p class="text-muted mb-1 small fw-semibold text-uppercase">İçerik</p>
                                            <p class="mb-0">@duyuru.Content</p>
                                        </div>
                                        <div class="col-md-5">
                                            <p class="text-muted mb-1 small fw-semibold text-uppercase">Detaylar</p>
                                            <ul class="list-unstyled small mb-0">
                                                <li class="mb-1">
                                                    <i class="bi bi-hash me-2 text-muted"></i>
                                                    ID: <strong>@duyuru.Id</strong>
                                                </li>
                                                <li class="mb-1">
                                                    <i class="bi bi-calendar2-check me-2 text-muted"></i>
                                                    Yayınlanma Zamanı: <strong>@duyuru.PublishedAt.ToString("dd MMMM yyyy HH:mm:ss")</strong>
                                                </li>
                                                <li class="mb-1">
                                                    <i class="bi bi-people me-2 text-muted"></i>
                                                    Gözlemci Sayısı: <strong>@duyuru.ObserverCount</strong>
                                                </li>
                                                @if (duyuru is ExamAnnouncement sinav)
                                                {
                                                    <li class="mb-1">
                                                        <i class="bi bi-journal-text me-2 text-danger"></i>
                                                        Ders: <strong>@sinav.SubjectName</strong>
                                                    </li>
                                                    <li class="mb-1">
                                                        <i class="bi bi-calendar-x me-2 text-danger"></i>
                                                        Sınav Tarihi: <strong>@sinav.ExamDate.ToString("dd MMMM yyyy")</strong>
                                                    </li>
                                                    <li>
                                                        <i class="bi bi-door-closed me-2 text-danger"></i>
                                                        Salon: <strong>@sinav.ExamRoom</strong>
                                                    </li>
                                                }
                                                else if (duyuru is EventAnnouncement etkinlik)
                                                {
                                                    <li class="mb-1">
                                                        <i class="bi bi-geo-alt me-2 text-success"></i>
                                                        Mekan: <strong>@etkinlik.Venue</strong>
                                                    </li>
                                                    <li class="mb-1">
                                                        <i class="bi bi-calendar-check me-2 text-success"></i>
                                                        Etkinlik Tarihi: <strong>@etkinlik.EventDate.ToString("dd MMMM yyyy")</strong>
                                                    </li>
                                                    <li>
                                                        <i class="bi bi-person-check me-2 text-success"></i>
                                                        Düzenleyen: <strong>@etkinlik.Organizer</strong>
                                                    </li>
                                                }
                                            </ul>
                                        </div>
                                    </div>
                                </div>
                            </div>

                        </div>
                    }
                }
            </div>
        </div>
    </div>
</div>

<!-- ════════════════════════════════════════════════════════
     SATIR 4 — CANLI BİLDİRİM SİMÜLASYON LOGLARI
     ════════════════════════════════════════════════════════ -->
<div class="row g-4 mb-4">
    <div class="col-12">

        <div class="log-konsol-baslik shadow-sm">
            <div class="d-flex align-items-center gap-2">
                <span class="terminal-nokta" style="background:#ff5f57;"></span>
                <span class="terminal-nokta" style="background:#febc2e;"></span>
                <span class="terminal-nokta" style="background:#28c840;"></span>
                <span class="ms-2 text-white-50 small fw-semibold" style="font-family:monospace;">
                    AkademiPortal :: NotificationLogManager (Tekil) — Canlı Bildirim Simülasyon Logları
                </span>
            </div>
            <div class="d-flex align-items-center gap-3 flex-wrap">
                <span class="small" style="color:#58a6ff;"><i class="bi bi-envelope-fill me-1"></i>@Model.EmailNotificationCount e-posta</span>
                <span class="small" style="color:#3fb950;"><i class="bi bi-phone-fill me-1"></i>@Model.SmsNotificationCount sms</span>
                <span class="small" style="color:#e3b341;"><i class="bi bi-gear-fill me-1"></i>@Model.SystemEventCount sistem</span>
                <form asp-controller="Home" asp-action="ClearLogs" method="post" class="d-inline mb-0">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-sm btn-outline-danger py-0 px-2" style="font-size:.75rem;"
                            onclick="return confirm('Tüm bildirim logları silinsin mi?');">
                        <i class="bi bi-trash3 me-1"></i>Temizle
                    </button>
                </form>
                <a href="/Home/GetLogs" target="_blank" class="btn btn-sm btn-outline-secondary py-0 px-2" style="font-size:.75rem;">
                    <i class="bi bi-braces me-1"></i>JSON
                </a>
            </div>
        </div>

        <div class="log-konsol" id="logKonsolu">
            @if (!Model.NotificationLogs.Any())
            {
                <span style="color:#3a4a6a;">
                    Bildirim bekleniyor… Bir duyuru yayınlayarak canlı çıktıyı görün.
                    <span style="color:#3a7fe8;">█</span>
                </span>
            }
            else
            {
                @foreach (var girdi in Model.NotificationLogs)
                {
                    logSira++;
                    <div class="log-entry" id="log-@logSira" data-ham="@girdi">@girdi</div>
                }
            }
        </div>

    </div>
</div>

<!-- ════════════════════════════════════════════════════════
     SATIR 5 — MİMARİ REFERANS KARTLARI
     ════════════════════════════════════════════════════════ -->
<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card border-0 rounded-3 h-100" style="background:#e4edff;">
            <div class="card-body p-3">
                <h6 class="fw-bold text-primary mb-2"><i class="bi bi-diagram-3-fill me-2"></i>Fabrika Örüntüsü</h6>
                <p class="small text-muted mb-1"><code>IAnnouncementFactory</code> → <code>AnnouncementFactory</code></p>
                <p class="small text-muted mb-0"><strong>ExamAnnouncement / EventAnnouncement</strong> ve <strong>E-Posta / SMS</strong> servislerini çalışma zamanında oluşturur.</p>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-0 rounded-3 h-100" style="background:#e3f6ec;">
            <div class="card-body p-3">
                <h6 class="fw-bold text-success mb-2"><i class="bi bi-broadcast me-2"></i>Gözlemci Örüntüsü</h6>
                <p class="small text-muted mb-1"><code>ISubject</code> (Duyuru) ↔ <code>IObserver</code> (Kullanıcı)</p>
                <p class="small text-muted mb-0"><strong>@Model.TotalUsers kullanıcı</strong> kayıtlı. Hedef Kitle filtreli <code>Register()</code> desteği.</p>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-0 rounded-3 h-100" style="background:#fff8e1;">
            <div class="card-body p-3">
                <h6 class="fw-bold text-warning mb-2"><i class="bi bi-lock-fill me-2"></i>Tekil Örüntüsü</h6>
                <p class="small text-muted mb-1"><code>NotificationLogManager.Instance</code></p>
                <p class="small text-muted mb-0">Thread-safe çift kontrollü kilitleme. <strong>@Model.TotalNotifications</strong> log kaydı tutuluyor.</p>
            </div>
        </div>
    </div>
</div>

<!-- ════════════════════════════════════════════════════════
     BOOTSTRAP 5 MODAL — Yeni Gözlemci Ekle

     BAĞLAMA KURALLARI (tüm önceki hatalar giderildi):
       1. Modal id="addObserverModal" → butonun data-bs-target="#addObserverModal" ile EŞLEŞİR
       2. Modal, tüm diğer <form> etiketlerinin DIŞINDA konumlandırılmıştır
       3. Form field name nitelikleri controller parametreleriyle BİREBİR eşleşir:
            name="name"   → string name
            name="email"  → string email
            name="phone"  → string phone
            name="type"   → string type  (değerler: "Student" / "Teacher")
     ════════════════════════════════════════════════════════ -->
<div class="modal fade"
     id="addObserverModal"
     tabindex="-1"
     aria-labelledby="addObserverModalLabel"
     aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 overflow-hidden shadow-lg">

            <div class="modal-header py-3"
                 style="background:linear-gradient(90deg,#145a3a,#1e8a55);color:#fff;">
                <h5 class="modal-title fw-semibold" id="addObserverModalLabel">
                    <i class="bi bi-person-plus-fill me-2"></i>Yeni Gözlemci Ekle
                </h5>
                <button type="button"
                        class="btn-close btn-close-white"
                        data-bs-dismiss="modal"
                        aria-label="Kapat"></button>
            </div>

            <!-- Form tamamen modal-content içinde; diğer tüm form'ların dışında -->
            <form method="post"
                  asp-action="AddObserver"
                  asp-controller="Home"
                  id="addObserverForm">
                @Html.AntiForgeryToken()

                <div class="modal-body p-4">

                    <p class="text-muted small mb-4">
                        Yeni kullanıcı gözlemci listesine eklenir ve bir sonraki duyuru
                        yayınında <code>announcement.Register(user)</code> ile kayıt edilir.
                    </p>

                    <!-- name="name" → HomeController.AddObserver(string name, ...) -->
                    <div class="mb-3">
                        <label for="obsName" class="form-label fw-semibold">
                            <i class="bi bi-person me-1 text-success"></i>Ad Soyad
                            <span class="text-danger">*</span>
                        </label>
                        <input type="text"
                               name="name"
                               id="obsName"
                               class="form-control"
                               placeholder="ör. Burak Öztürk"
                               required />
                    </div>

                    <!-- name="email" → HomeController.AddObserver(..., string email, ...) -->
                    <div class="mb-3">
                        <label for="obsEmail" class="form-label fw-semibold">
                            <i class="bi bi-envelope me-1 text-success"></i>E-posta
                            <span class="text-danger">*</span>
                        </label>
                        <input type="email"
                               name="email"
                               id="obsEmail"
                               class="form-control"
                               placeholder="kullanici@uni.edu.tr"
                               required />
                    </div>

                    <!-- name="phone" → HomeController.AddObserver(..., string phone, ...) -->
                    <div class="mb-3">
                        <label for="obsPhone" class="form-label fw-semibold">
                            <i class="bi bi-telephone me-1 text-success"></i>Telefon
                            <span class="text-muted small ms-1">(İsteğe bağlı)</span>
                        </label>
                        <input type="tel"
                               name="phone"
                               id="obsPhone"
                               class="form-control"
                               placeholder="+90-5xx-xxx-xxxx" />
                    </div>

                    <!-- name="type" → HomeController.AddObserver(..., string type)
                         Değerler: "Student" → UserType.Student | "Teacher" → UserType.Teacher -->
                    <div class="mb-0">
                        <label for="obsType" class="form-label fw-semibold">
                            <i class="bi bi-person-badge me-1 text-success"></i>Rol
                        </label>
                        <select name="type" id="obsType" class="form-select">
                            <option value="Student">🎓 Öğrenci</option>
                            <option value="Teacher">👨‍🏫 Akademisyen</option>
                        </select>
                        <div class="form-text">
                            Seçilen rol bildirim loglarında ve Hedef Kitle filtresinde kullanılır.
                        </div>
                    </div>

                </div>

                <div class="modal-footer border-top bg-light px-4 py-3">
                    <button type="button"
                            class="btn btn-outline-secondary"
                            data-bs-dismiss="modal">
                        <i class="bi bi-x-circle me-1"></i>İptal
                    </button>
                    <!-- Submit label: "Gözlemciyi Kaydet" as specified -->
                    <button type="submit" class="btn btn-success fw-semibold px-4">
                        <i class="bi bi-check-circle-fill me-1"></i>Gözlemciyi Kaydet
                    </button>
                </div>

            </form>

        </div>
    </div>
</div>

@section Scripts {
<script>
/* ── Log renklendirme (Vanilla JS) ─────────────────────────────
   E-Posta → mavi | SMS → yeşil | SİSTEM → sarı
   Bootstrap 5 collapse ve modal için ek JS gerekmez.
   ─────────────────────────────────────────────────────────────── */
(function () {
    var k = document.getElementById('logKonsolu');
    if (!k) return;

    k.querySelectorAll('.log-entry[data-ham]').forEach(function (el) {
        var ham  = el.getAttribute('data-ham') || '';
        var tsM  = ham.match(/^\[(\d{2}:\d{2}:\d{2})\]/);
        var ts   = tsM ? tsM[0] : '';
        var rest = tsM ? ham.slice(ts.length) : ham;
        var html = '';

        if (ham.includes('[E-POSTA]')) {
            html = '<span class="log-ts">'  + esc(ts)   + '</span>'
                 + '<span class="log-eposta"> <span class="log-rozet-eposta">[E-POSTA]</span>'
                 + esc(rest.replace('[E-POSTA]', '')) + '</span>';
        } else if (ham.includes('[SMS]')) {
            html = '<span class="log-ts">'  + esc(ts)   + '</span>'
                 + '<span class="log-sms"> <span class="log-rozet-sms">[SMS]</span>'
                 + esc(rest.replace('[SMS]', '').replace(/^\s+/, '')) + '</span>';
        } else {
            var rEsc = esc(rest)
                .replace('[S\u0130STEM]', '<span class="log-rozet-sistem">[S\u0130STEM]</span>')
                .replace('[SISTEM]',     '<span class="log-rozet-sistem">[SISTEM]</span>');
            html = '<span class="log-ts">'  + esc(ts)   + '</span>'
                 + '<span class="log-sistem"> ' + rEsc   + '</span>';
        }
        el.innerHTML = html;
    });

    k.scrollTop = k.scrollHeight;

    function esc(s) {
        return s.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
    }
}());

/* ── Publish form UX ──────────────────────────────────────────── */
(function () {
    var f   = document.getElementById('duyuruFormu');
    var btn = document.getElementById('gonderBtn');
    if (f && btn) {
        f.addEventListener('submit', function () {
            btn.disabled = true;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Yayınlanıyor…';
        });
    }
}());
</script>
}

<!-- ZORUNLU BOOTSTRAP 5 JS ENJEKSİYONU
     Tüm collapse, modal ve dropdown işlemlerinin çalışmasını garantilemek için
     mutlak dosya sonunda eklenmektedir. -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
